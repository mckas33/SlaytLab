# SlaytLab — istemci ortam değişkenleri (gizli anahtar koyma)
# Kopyala: cp .env.example .env.local

# Supabase proje URL'si (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase anon / public key (service_role ASLA buraya konmaz)
VITE_SUPABASE_ANON_KEY=your-anon-key

# E-posta yönlendirmeleri için kanonik site adresi (production'da zorunlu önerilir)
# Yerelde boş bırakılırsa window.location.origin kullanılır
# Örnek production: https://slaytlab.vercel.app
VITE_SITE_URL=
